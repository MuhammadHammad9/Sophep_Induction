{
  "name": "@sophep/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./services/*": "./src/services/*.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:concurrency": "vitest run tests/concurrency",
    "test:golden": "vitest run tests/golden",
    "db:migrate": "node --env-file=../.env scripts/migrate.mjs",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file=../.env scripts/seed.mjs",
    "db:diff": "supabase db diff -f",
    "db:reset-test": "node --env-file=../.env scripts/reset-test-db.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "supabase": "^2.2.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
