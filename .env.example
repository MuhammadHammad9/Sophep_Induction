# Copy to .env.local and fill in. NEVER commit the filled version (rules.md R-056, NFR-SEC-009).

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — never expose to a client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct connection for migrations and the RLS/concurrency test suites.
DATABASE_URL=

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application-layer encryption key for cycle Ed25519 private keys and TOTP secrets,
# in addition to storage encryption (NFR-SEC-002). Held in a managed key service in production.
# The Ed25519 PRIVATE key never leaves the server (rules.md R-021).
APP_ENCRYPTION_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
# Unset until a Resend account and verified sending domain exist. While unset, the mock
# adapter persists messages to the notifications table and renders them at /dev/notifications.
# Delivery is asynchronous either way (FR-NOT-001) — the mock does not shortcut that.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
