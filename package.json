{
  "name": "sophep-rms",
  "version": "0.1.0",
  "private": true,
  "description": "SOPHEP Recruitment Management System \u2014 cycle-based induction platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node init && npm run dev --workspace=@sophep/frontend",
    "build": "node init && npm run build --workspace=@sophep/frontend",
    "start": "node init && npm run start --workspace=@sophep/frontend",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "npm run test:rls --workspace=@sophep/backend",
    "test:concurrency": "npm run test:concurrency --workspace=@sophep/backend",
    "test:golden": "npm run test:golden --workspace=@sophep/backend",
    "test:schema": "npm run test:schema --workspace=@sophep/backend",
    "test:e2e": "npm run test:e2e --workspace=@sophep/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:preflight": "npm run db:preflight --workspace=@sophep/backend",
    "db:migrate": "npm run db:migrate --workspace=@sophep/backend",
    "db:reset": "npm run db:reset --workspace=@sophep/backend",
    "db:seed": "npm run db:seed --workspace=@sophep/backend",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
